
from itertools import product

def implies(a, b):
    return (not a) or b

print("P Q R | Q->P | P->~Q | QvR | KB")
print("-" * 39)

models = []

for P, Q, R in product([True, False], repeat=3):
    s1 = implies(Q, P)
    s2 = implies(P, not Q)
    s3 = Q or R

    KB = s1 and s2 and s3

    values = lambda x: "T" if x else "F"

    print(
        values(P), values(Q), values(R), "|",
        values(s1), "  |",
        values(s2), "    |",
        values(s3), " |",
        values(KB)
    )

    if KB:
        models.append((P, Q, R))

# Check entailment using all models of KB
entails_R = all(R for P, Q, R in models)

entails_R_implies_P = all(
    implies(R, P) for P, Q, R in models
)

entails_Q_implies_R = all(
    implies(Q, R) for P, Q, R in models
)

print("\nModels of KB:")
for model in models:
    print(model)

print("\nKB entails R:", entails_R)
print("KB entails R -> P:", entails_R_implies_P)
print("KB entails Q -> R:", entails_Q_implies_R)
